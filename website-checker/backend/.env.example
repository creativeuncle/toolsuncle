PORT=5501

# Set to "true" only for local development when you need to scan
# localhost/private targets (e.g. a local test fixture). Never enable
# this in a deployed environment — it disables the SSRF guard.
ALLOW_PRIVATE_SCAN_TARGETS=false

# Optional. Pin a specific/system Chromium binary for deep-scan browser
# checks instead of Playwright's own downloaded copy (useful in Docker to
# avoid bundling a second Chromium). Leave unset to use Playwright's default.
# PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium
